# ========================================================
# RYO Shogun (将軍) — Environment Configuration Template
# ========================================================

# Port for the Shogun Backend API
PORT=3001

# RYO-CHAN MCP API Endpoint
RYO_MCP_ENDPOINT=https://app-ryochan.com/api/mcp

# RYO-CHAN Builder Key (Granted by hackathon organizers on Discord/Telegram)
# Format: ryo_mcp_... (If omitted, Shogun gracefully operates using its internal realistic mock data)
RYO_MCP_KEY=

# Optional LLM API Key (Gemini, Claude, or OpenAI for natural language council debate narration)
# If left blank, Shogun uses deterministic Bushido heuristic reasoning
GEMINI_API_KEY=

# Automated market scan interval in milliseconds (default: 30000 = 30 seconds)
SCAN_INTERVAL_MS=30000

# Paper trading starting balance in USD (simulated)
SIMULATED_STARTING_BALANCE_USD=10000
